# Copy to .env and fill in. Everything here is read by backend/internal/infrastructure/config.
# docker-compose passes this file to the backend container via `env_file`.

# --- server ---
PORT=8080
# "development" relaxes the checks below; anything else requires real secrets.
ENV=development

# --- datastores ---
DATABASE_URL=postgres://go_poker:go_poker@localhost:5432/go_poker?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- telegram ---
# Required unless ENV=development. From @BotFather.
TELEGRAM_BOT_TOKEN=
# How long a signed initData payload stays acceptable.
TELEGRAM_AUTH_TTL=24h

# --- sessions ---
# Signs session JWTs. Anyone holding this can forge a token for ANY player, so
# treat it like a password: >=32 random bytes, `openssl rand -base64 48`.
# Required unless ENV=development; startup fails if left at the default.
# Safe to rotate whenever you like: it only logs everyone out.
SESSION_SECRET=change-me-in-production
SESSION_TTL=168h

JWT_ISSUER=gopoker

# --- origins ---
# Public URL of the Mini App.
APP_URL=http://localhost:5173

# Comma-separated origins allowed to call the API from a browser.
# Leave EMPTY for same-origin setups (local dev and docker-compose, where nginx
# serves the SPA and proxies /api on the same host).
# Set this only when the frontend is hosted separately, e.g. on Vercel:
#   CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app
CORS_ORIGINS=

# Copy to frontend/.env for local development.
# Vite only exposes variables prefixed with VITE_, and inlines them at BUILD time —
# changing either of these requires a rebuild, not just a restart.

# Signed Telegram initData for testing in a plain browser, outside Telegram.
# Compiled out of production builds: it is read behind `import.meta.env.DEV`.
VITE_DEV_TOKEN=

# Public URL of the API. Leave EMPTY for same-origin setups — local dev proxies
# /api through Vite, and docker-compose serves both from nginx.
# Set this when the SPA is hosted separately, e.g. on Vercel:
#   VITE_API_BASE=https://your-backend.fly.dev
# The websocket URL is derived from it (http -> ws, https -> wss), because
# Vercel rewrites cannot proxy WebSocket upgrades.
VITE_API_BASE=
